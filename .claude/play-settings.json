{
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "enabledPlugins": {
    "engineering@synced": false
  },
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "google-workspace": "off",
    "computer-use": "off",
    "built-in-browser": "off",
    "chrome-browser": "off",
    "deep-research": "off",
    "morning": "off",
    "skill-creator": "off",
    "import-memory": "off",
    "plugin-authoring": "off"
  },
  "permissions": {
    "deny": [
      "mcp__*",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "Artifact*",
      "NotebookEdit",
      "LSP",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "RemoteTrigger",
      "PushNotification",
      "ReportFindings",
      "ShareOnboardingGuide"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(\"$CLAUDE_PROJECT_DIR/bin/dmc\" redraw 2>&1); s=$?; if [ \"$s\" = 2 ]; then printf '%s\\n' \"$out\" >&2; exit 2; fi; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/dmc\" context-check 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
