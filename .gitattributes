# Shell scripts must keep LF line endings or bash cannot run them
*.sh text eol=lf

# PDF test fixtures are binary: no line-ending conversion
*.pdf binary
# Spec Kit hashes the bytes of its skill files in .specify/integrations/*.manifest.json;
# keep them LF on every checkout so `specify integration upgrade` sees no change
.claude/skills/speckit-*/SKILL.md text eol=lf

# kit/ is embedded in dmc and written into players' DMC folders: keep it LF on every checkout so that every build embeds the same bytes
kit/** text eol=lf

# The golden fixtures of the campaign migrations are compared as text: keep them LF on every checkout
tests/Dmc.Tests/Fixtures/migrations/** text eol=lf
