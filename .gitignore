# Campaign saves are personal and stay out of the repository
adventures/*
!adventures/.gitkeep

# Published modules are copyrighted: neither the source files nor the digests are shared
modules/*
!modules/.gitkeep

# The local rules reference is downloaded by each user (see README)
rules/*
!rules/.gitkeep

# Python libraries installed locally for scripts/pdf_extract.py
scripts/.pylib/
__pycache__/

# Personal Claude Code overrides
.claude/settings.local.json
