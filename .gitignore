# Campaign saves are personal and stay out of the repository
adventures/*
!adventures/.gitkeep

# Published modules are copyrighted: neither the source files nor the digests are shared
modules/*
!modules/.gitkeep

# The local rules reference is downloaded by each user (see README)
rules/*
!rules/.gitkeep

# Python libraries installed locally for scripts/pdf_extract.py (until the scripts go in Phase 6 of issue #3)
scripts/.pylib/
__pycache__/

# .NET build output. bin/ at the root is where "dotnet publish src/Dmc.Cli -r <rid> -o bin" puts dmc.
bin/
obj/
artifacts/
TestResults/

# Personal Claude Code overrides
.claude/settings.local.json
