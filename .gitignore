# Players keep their own files in a DMC folder, not here; a maintainer's old checkout may still hold some, and they stay out of the repository
# Campaign saves are personal
adventures/*

# Campaign exports (dmc campaign export) hold whole campaigns, spoilers included: personal data, kept out of git
exports/*

# Published modules are copyrighted: neither the source files nor the digests are shared
modules/*

# Feedback about DMC quotes the player and can hold spoilers: personal data, kept out of git
feedback/*

# The local rules reference is downloaded by each user
rules/*

# Leftovers of the removed Python scripts in older checkouts (safe to delete)
scripts/.pylib/
__pycache__/

# .NET build output. A developer publishes dmc to artifacts/bin; bin/ at the root, where an older checkout's launcher
# put the player's dmc, stays ignored.
bin/
obj/
artifacts/
TestResults/

# Personal Claude Code overrides
.claude/settings.local.json
