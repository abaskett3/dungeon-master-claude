# Campaign saves are personal and stay out of the repository
adventures/*
!adventures/.gitkeep

# Published modules are copyrighted: neither the source files nor the digests are shared
modules/*
!modules/.gitkeep

# The local rules reference is downloaded by each user (see README)
rules/*
!rules/.gitkeep

# Leftovers of the removed Python scripts in older checkouts (safe to delete)
scripts/.pylib/
__pycache__/

# .NET build output. bin/ at the root is the player's install of dmc, which tools/get-dmc owns (a build of your own
# put there is replaced by the pinned release); a developer publishes to artifacts/bin.
bin/
obj/
artifacts/
TestResults/

# Personal Claude Code overrides
.claude/settings.local.json
