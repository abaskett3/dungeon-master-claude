<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dmc</AssemblyName>
    <RootNamespace>Dmc</RootNamespace>
    <!-- Every build that is not a release says so: "dmc" with the version option prints "dmc 0.0.0-dev", which no release ever prints,
         so get-dmc replaces it with the pinned release and the stale-binary warning leaves it alone. A release gets its
         exact version from its tag (release.yml builds it with -p:Version=X.Y.Z); nothing writes it back here. -->
    <Version>0.0.0-dev</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run the AOT, trim and single-file analyzers on every build, so a local build already shows what a release
         build would complain about. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Directory.Build.props builds dmc.xml, the XML comments, so that a missing comment is reported (CS1591, an error
         here, because warnings are errors). It is not part of what is published: artifacts/bin and the release archives
         hold the program and its native libraries, as they did before. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!--
    How dmc is built (issue #3, "Build and release"):

      Local default   dotnet publish src/Dmc.Cli -r <rid> -o artifacts/bin
                      A self-contained single-file build without AOT. It needs no C++ or clang toolchain and no
                      flags. It starts in about 160 ms on Windows.

      Release and CI  dotnet publish src/Dmc.Cli -r <rid> -o artifacts/bin -p:PublishAot=true
                      Native AOT: starts in under 30 ms, needs Visual Studio's C++ workload on Windows, clang and
                      zlib1g-dev on Linux. Any test that measures time must use this build.

    Plain "dotnet build" and "dotnet test" use neither: they build an ordinary framework-dependent assembly.
  -->
  <PropertyGroup>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true' and '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dmc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liberation Sans (SIL OFL 1.1; the licence sits next to the fonts), embedded so that the map PNG has text on a
         machine with no fonts installed. -->
    <EmbeddedResource Include="Maps\Fonts\*.ttf" LogicalName="Dmc.Maps.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
