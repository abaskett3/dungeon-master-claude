<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dmc</AssemblyName>
    <RootNamespace>Dmc</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run the AOT, trim and single-file analyzers on every build, so a local build already shows what a release
         build would complain about. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- CA1416: PDFtoImage marks its API as Windows, Linux, macOS and others only. dmc ships for exactly those three. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    How dmc is built (issue #3, "Build and release"):

      Local default   dotnet publish src/Dmc.Cli -r <rid> -o bin
                      A self-contained single-file build without AOT. It needs no C++ or clang toolchain and no
                      flags. It starts in about 160 ms on Windows.

      Release and CI  dotnet publish src/Dmc.Cli -r <rid> -o bin -p:PublishAot=true
                      Native AOT: starts in under 30 ms, needs Visual Studio's C++ workload on Windows, clang and
                      zlib1g-dev on Linux, and the Xcode command line tools on macOS. Any test that measures time
                      must use this build.

    Plain "dotnet build" and "dotnet test" use neither: they build an ordinary framework-dependent assembly.
  -->
  <PropertyGroup>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true' and '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dmc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liberation Sans (SIL OFL 1.1; the licence sits next to the fonts), embedded so that the map PNG has text on a
         machine with no fonts installed. -->
    <EmbeddedResource Include="Maps\Fonts\*.ttf" LogicalName="Dmc.Maps.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
