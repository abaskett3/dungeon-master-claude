<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dmc.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.Playwright.MSTest.v4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-process layer calls the library code of the CLI project directly. The black-box layer runs the
         published binary (bin/dmc), which "dotnet publish src/Dmc.Cli -r <rid> -o bin" produces. -->
    <ProjectReference Include="..\..\src\Dmc.Cli\Dmc.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
