<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dmc.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The documentation file is built here too (see Directory.Build.props), so the compiler checks that every comment
         is well formed: a param tag for every parameter or none, a cref that resolves. CS1591 (no comment on a visible
         member) is the one check switched off, and only here. MSTest needs a test class and every test method to be
         public, and a test method whose name says what it proves needs no comment, so the check would flag several
         hundred members that are meant to have none. Test classes, helpers and fixtures are documented all the same;
         that is kept by review, not by the compiler. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.Playwright.MSTest.v4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-process layer calls the library code of the CLI project directly. The black-box layer runs the
         published binary (artifacts/bin/dmc), which "dotnet publish src/Dmc.Cli -r <rid> -o artifacts/bin" produces. -->
    <ProjectReference Include="..\..\src\Dmc.Cli\Dmc.Cli.csproj" />
    <!-- The tests run on the same three OSes, so the platform analyzer accepts their calls into the CLI. -->
    <Compile Include="..\..\src\Dmc.Cli\SupportedPlatforms.cs" Link="SupportedPlatforms.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
